# ===== 交叉编译系统根（体积大，绝不入库）=====
aarch64-sysroot/
amd64-sysroot/

# ===== 编译产物 =====
annotate_amd64
annotate_aarch64
annotate_*
*.o
*.obj
*.a
*.so
*.new
build/
bin/
moc_*.cpp
ui_*.h
qrc_*.cpp

# ===== Rust 编译产物 =====
rust/target/
windows/target/
windows/dist/

# ===== 项目内 Rust 工具链（Windows 交叉编译）=====
.toolchains/

# ===== 本地 Windows 安装包 / 测试镜像（不入库）=====
/WPS_Setup_*.exe
/kms/
*.iso
*.log

# ===== Wayland 协议绑定生成物（wayland-scanner 输出，构建时落在 build/）=====
# protocols/ 下的 .xml 为源文件，需要入库；生成的头/源文件一律忽略。
*-client-protocol.h
*-protocol.c

# ===== 打包产物与临时目录（deb / rpm / arch）=====
*.deb
*.rpm
*.pkg.tar.zst
rust/dist/
screen-annotate_*/
sidera_*/

# ===== Python 缓存 =====
__pycache__/
*.pyc

# ===== 编辑器 / 系统杂项 =====
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/
*.user
compile_commands.json
.cache/

# 注意：.gitignore 只对“未跟踪”文件生效。
# 若某文件在加入本规则前已被 git 跟踪，需手动取消跟踪：
#   git rm -r --cached <path>
